{
  "name": "@sandeepraju/kasa-mcp",
  "version": "0.1.0",
  "description": "MCP (Model Context Protocol) server for Kasa smart home devices",
  "type": "module",
  "main": "./build/index.js",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "bin": {
    "kasa-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "dev": "tsc --watch",
    "prepare": "pnpm run build",
    "test": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm typecheck && pnpm lint",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js",
    "start:stdio": "node build/index.js",
    "start:http": "MCP_TRANSPORT=http node build/index.js",
    "start:http:stateless": "MCP_TRANSPORT=http MCP_SESSION_MODE=stateless node build/index.js",
    "dev:http": "tsc && MCP_TRANSPORT=http node build/index.js",
    "inspector:http": "npx @modelcontextprotocol/inspector http://localhost:3000/mcp",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kasa",
    "smart-home",
    "ai"
  ],
  "author": {
    "name": "Sandeep Raju Prabhakar",
    "email": "me@sandeepraju.in",
    "url": "https://github.com/sandeepraju"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandeepraju/kasa-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sandeepraju/kasa-mcp/issues"
  },
  "homepage": "https://github.com/sandeepraju/kasa-mcp",
  "readme": "README.md",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "tplink-smarthome-api": "^5.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
